<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>tui-edit</AssemblyName>
    <RootNamespace>TuiEdit</RootNamespace>
    <Version>0.9.2</Version>
    <Description>Простой TUI текстовый редактор в стиле Microsoft Edit / nano на чистом System.Console.</Description>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisMode>Recommended</AnalysisMode>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="TuiEdit.Tests\**" />
    <EmbeddedResource Remove="TuiEdit.Tests\**" />
    <None Remove="TuiEdit.Tests\**" />
    <Compile Remove="TuiEdit.Bench\**" />
    <EmbeddedResource Remove="TuiEdit.Bench\**" />
    <None Remove="TuiEdit.Bench\**" />
    <InternalsVisibleTo Include="TuiEdit.Tests" />
    <InternalsVisibleTo Include="TuiEdit.Shots" />
    <InternalsVisibleTo Include="TuiEdit.Bench" />
    <EmbeddedResource Include="Resources\*.json" WithCulture="false" />
    <EmbeddedResource Include="Grammars\*.json" WithCulture="false" />
  </ItemGroup>

</Project>
