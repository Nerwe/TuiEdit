<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>tui-edit</AssemblyName>
    <RootNamespace>TuiEdit</RootNamespace>
    <Version>0.1.0</Version>
    <Description>Простой TUI текстовый редактор в стиле Microsoft Edit / nano на чистом System.Console.</Description>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="TuiEdit.Tests\**" />
    <EmbeddedResource Remove="TuiEdit.Tests\**" />
    <None Remove="TuiEdit.Tests\**" />
    <InternalsVisibleTo Include="TuiEdit.Tests" />
    <InternalsVisibleTo Include="TuiEdit.Shots" />
    <!-- WithCulture=false: убрать .en./.ru. из имён встроенных файлов и satellite-сборок -->
    <EmbeddedResource Include="Resources\*.json" WithCulture="false" />
  </ItemGroup>

</Project>
