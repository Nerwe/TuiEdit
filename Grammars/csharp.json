{
  "Name": "C#",
  "Extensions": [".cs"],
  "LineComment": "//",
  "Rules": [
    { "Scope": "comment", "Begin": "/\\*", "End": "\\*/" },
    { "Scope": "comment", "Match": "//.*$" },
    { "Scope": "comment", "Match": "^\\s*#\\w+.*" },
    { "Scope": "string", "Match": "\"(?:\\\\.|[^\"\\\\])*\"?" },
    { "Scope": "string", "Match": "'(?:\\\\.|[^'\\\\])*'" },
    { "Scope": "string", "Match": "\\$\"(?:\\\\.|[^\"\\\\])*\"?" },
    { "Scope": "keyword", "Match": "\\b(?:abstract|as|async|await|base|bool|break|byte|case|catch|char|checked|class|const|continue|decimal|default|delegate|do|double|else|enum|event|explicit|extern|false|finally|fixed|float|for|foreach|get|goto|if|implicit|in|init|int|interface|internal|is|lock|long|namespace|new|null|object|operator|out|override|params|partial|private|protected|public|readonly|record|ref|required|return|sbyte|sealed|set|short|sizeof|stackalloc|static|string|struct|switch|this|throw|true|try|typeof|uint|ulong|unchecked|unsafe|ushort|using|var|virtual|void|volatile|while|with|yield)\\b" },
    { "Scope": "number", "Match": "\\b\\d[\\d_]*(?:\\.\\d+)?\\b" },
    { "Scope": "type", "Match": "\\b[A-Z][\\w]*" }
  ]
}
